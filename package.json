{
  "name": "@quantovainc/qspend",
  "version": "0.7.4",
  "description": "Post quantum public spending integrity for governments. Seals appropriations, allotments, commitments, receipts, invoices and payments with ML-DSA-65 under FIPS 204 and Quantova time proofs, so a payment without authority, above its commitment or made twice is detected.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qspend": "bin/qspend.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--require=$PWD/test/clock.js\" node --test test/*.test.js",
    "lint": "eslint ."
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "bin/",
    "wasm/qspend_native.js",
    "wasm/qspend_native_bg.wasm",
    "wasm/qspend_native.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "AUTHORS"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@quantovainc/qstamp": "0.6.4"
  },
  "keywords": [
    "post-quantum",
    "quantum-safe",
    "public-finance",
    "budget",
    "treasury",
    "anti-corruption",
    "government",
    "ml-dsa",
    "fips-204",
    "quantova"
  ],
  "license": "Apache-2.0 OR MIT",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/QSpend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/QSpend.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/QSpend/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.1",
    "eslint-plugin-security": "3.0.1",
    "globals": "16.5.0"
  }
}
